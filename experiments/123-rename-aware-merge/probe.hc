Hgit("offer C:/Home/P125A.hgs C:/Home/P125W1/*.txt main_renames_a_to_c");
CommPrint(1, "P125_MERGE_RENAME_EDIT\n");
Hgit("merge C:/Home/P125A.hgs feat");
U8 h[64]; U8 hex[129]; U8 cmd[300];
CurrentHeadRead("C:/Home/P125A.hgs", h);
HashToHex(h, hex);
StrPrint(cmd, "see C:/Home/P125A.hgs %s", hex);
Hgit(cmd);
StrPrint(cmd, "diff C:/Home/P125A.hgs %s", hex);
Hgit(cmd);
Hgit("check C:/Home/P125A.hgs");

CommPrint(1, "P125_RENAME_RENAME\n");
FileWrite("C:/Home/P125W2/a.txt", "base_a_content_long_enough\n", 27);
FileWrite("C:/Home/P125W2/b.txt", "base_b\n", 7);
Hgit("init C:/Home/P125B.hgs");
Hgit("offer C:/Home/P125B.hgs C:/Home/P125W2/*.txt base");
