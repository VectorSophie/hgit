FileWrite("C:/Home/P125W1/a.txt", "base_a_content_long_enough\n", 27);
FileWrite("C:/Home/P125W1/b.txt", "base_b\n", 7);
Hgit("init C:/Home/P125A.hgs");
Hgit("offer C:/Home/P125A.hgs C:/Home/P125W1/*.txt base");
