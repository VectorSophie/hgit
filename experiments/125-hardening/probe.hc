CommPrint(1, "P127_BEGIN\n");
U8 h[64]; U8 fake[64]; I64 zi;
for (zi=0; zi<64; zi++) fake[zi] = 7;

Del("C:/Home/P127A.hgs", FALSE, FALSE, FALSE);
Del("C:/Home/P127A.hgs.m", FALSE, FALSE, FALSE);
FileWrite("C:/Home/P127W/a.txt", "hello\n", 6);
